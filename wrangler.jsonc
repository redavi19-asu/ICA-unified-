{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ica-unified",
	"compatibility_date": "2026-09-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"SOCIAL_GOOGLE_CLIENT_ID": "493512781101-54s3bmlkvdl28oe4umjssknrv53cia5c.apps.googleusercontent.com",
		"SOCIAL_AUTH_ORIGIN": "https://unified.icomputeranything.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ica-unified",
			"database_id": "b792de23-6792-48ab-a68a-c1ebf611ba05"
		},
		{
			"binding": "ICA_DB",
			"database_name": "ica-saas-db",
			"database_id": "888f63b8-f1bb-4419-b806-6b306579c632"
		}
	],
	"r2_buckets": [
		{
			"binding": "ICA_UNIFIED_STORAGE",
			"bucket_name": "ica-unified-storage"
		}
	],
	"stream": {
		"binding": "STREAM"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ica-unified"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
