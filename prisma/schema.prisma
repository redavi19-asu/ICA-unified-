generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  OVERDUE
}

enum MemberStatus {
  INVITED
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LessonKind {
  TEXT
  VIDEO
  DOCUMENT
  QUIZ
}

model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(PLATFORM_ADMIN)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  status          OrganizationStatus @default(TRIAL)
  plan            String             @default("trial")
  trialEndsAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     Membership[]
  invitations     Invitation[]
  courses         Course[]
  lessons         Lesson[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  credentials     Credential[]
  documents       Document[]
  acknowledgments Acknowledgment[]
  activities      Activity[]
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  credentials     Credential[]
  acknowledgments Acknowledgment[]
  activities      Activity[]       @relation("ActivityActor")
  sentInvitations Invitation[]     @relation("InvitationSender")
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  status         MemberStatus @default(ACTIVE)
  jobTitle       String?
  joinedAt       DateTime     @default(now())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  name           String
  jobTitle       String?
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?
  invitedById    String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
}

model Course {
  id                   String        @id @default(cuid())
  organizationId       String
  title                String
  description          String?
  required             Boolean       @default(false)
  durationMin          Int           @default(0)
  passingScore         Int           @default(80)
  certificateValidDays Int?
  published            Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessons              Lesson[]
  enrollments          Enrollment[]
  quizAttempts         QuizAttempt[]

  @@unique([organizationId, title])
  @@index([organizationId, published])
}

model Lesson {
  id             String           @id @default(cuid())
  organizationId String
  courseId       String
  order          Int
  title          String
  kind           LessonKind       @default(TEXT)
  content        String
  mediaUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]
  progress       LessonProgress[]

  @@unique([courseId, order])
  @@index([organizationId, courseId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  order         Int
  prompt        String
  optionsJson   String
  correctAnswer String
  explanation   String?
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  courseId       String
  status         EnrollmentStatus @default(NOT_STARTED)
  progress       Int              @default(0)
  score          Int?
  attempts       Int              @default(0)
  dueAt          DateTime?
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  credential     Credential?

  @@unique([userId, courseId])
  @@index([organizationId, status])
}

model LessonProgress {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  lessonId       String
  completedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([organizationId, userId])
}

model QuizAttempt {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  courseId       String
  lessonId       String
  score          Int
  passed         Boolean
  answersJson    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, courseId])
}

model Credential {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  enrollmentId   String?      @unique
  code           String?      @unique
  name           String
  issuedAt       DateTime?
  expiresAt      DateTime?
  status         String       @default("active")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, expiresAt])
}

model Document {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  version         String           @default("1.0")
  requiresAck     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acknowledgments Acknowledgment[]

  @@index([organizationId])
}

model Acknowledgment {
  id             String       @id @default(cuid())
  organizationId String
  documentId     String
  userId         String
  acknowledgedAt DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([organizationId, acknowledgedAt])
}

model Activity {
  id             String        @id @default(cuid())
  organizationId String
  actorId        String?
  type           String
  message        String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
