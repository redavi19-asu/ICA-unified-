# Local/server database
DATABASE_URL="file:./dev.db"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional server-side fallback for absolute URLs
APP_BASE_URL="http://localhost:3000"

# Session signing
AUTH_SECRET="replace-with-a-long-random-secret"
PLATFORM_AUTH_SECRET="replace-with-a-separate-long-random-secret"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ICA Unified SaaS billing + Stripe Connect/member payments
STRIPE_SECRET_KEY=""
STRIPE_PROFESSIONAL_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Optional. When blank, Unified can create/find a cancellation-capable portal configuration.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# Transactional email (Resend)
# Production uses a dedicated Unified sender/domain; keep this separate from other ICA projects.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="ICA Unified <no-reply@unified.icomputeranything.com>"

# Optional ICA Assist AI. Without this, ICA Assist uses its built-in guided answers.
OPENAI_API_KEY=""

# One-time super administrator bootstrap values
SUPERADMIN_NAME="ICA Unified Super Administrator"
SUPERADMIN_EMAIL="owner@example.com"
SUPERADMIN_PASSWORD="replace-with-a-strong-password"

# Optional signed desktop-client release links
ICA_WINDOWS_DOWNLOAD_URL=""
ICA_MAC_DOWNLOAD_URL=""

# Cloudflare deployment values used by GitHub Actions / Wrangler
# Store real values as repository secrets, not in committed files.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Mobile app API target
EXPO_PUBLIC_ICA_API_URL="https://unified.icomputeranything.com"

# Optional Tracestrack Topo map tiles for the public ICA Unified globe
# Commercial use requires an appropriate Tracestrack plan/API key.
NEXT_PUBLIC_TRACESTRACK_API_KEY=""
