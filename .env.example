# Local/server database
DATABASE_URL="file:./dev.db"

# Session signing
AUTH_SECRET="replace-with-a-long-random-secret"
PLATFORM_AUTH_SECRET="replace-with-a-separate-long-random-secret"

# One-time super administrator bootstrap values
SUPERADMIN_NAME="ICA Unified Super Administrator"
SUPERADMIN_EMAIL="owner@example.com"
SUPERADMIN_PASSWORD="replace-with-a-strong-password"

# Public application URL used when external services are connected
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future Cloudflare production values
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_DATABASE_ID=""
